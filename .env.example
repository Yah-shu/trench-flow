# Copy this file to `.env` (in the trench-flow folder) to change any of these. Everything is optional.

# The port the app runs on (http://127.0.0.1:7766), and the dev page's port for `bun run dev`.
# TRENCHFLOW_PORT=7766
# TRENCHFLOW_WEB_PORT=7767

# Where your data is kept (default: .trench-flow in your home folder).
# TRENCHFLOW_DIR=

# Don't open the window when the app starts.
# TRENCHFLOW_NO_OPEN=1

# Turn off the free local look-alike matcher (it downloads a ~23 MB model once).
# TRENCHFLOW_NO_EMBED=1

# Skip the weekly Claude usage check (the AI then never pauses near your plan's cap).
# TRENCHFLOW_SKIP_USAGE=1

# Where the Claude Code CLI is, if trench-flow can't find it by itself.
# CLAUDE_BIN=

# Where ffmpeg is (Windows screenshots), if trench-flow can't find it by itself.
# FFMPEG_PATH=
