{
  "name": "trench-flow",
  "private": true,
  "version": "0.1.0",
  "description": "See where your day went: a private, local time tracker built on ActivityWatch, with optional AI summaries on your own Claude plan.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun --watch server/main.ts --no-open\" \"vite\"",
    "build": "vite build",
    "start": "bun server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.board.json",
    "add-matcher": "bun add --no-save @huggingface/transformers@4.3.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "hono": "^4.12.28",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
